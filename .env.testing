# Ambiente de testes locais (php artisan test).
# Alinhado com docker-compose.yml: MYSQL_ROOT_PASSWORD=rootsecret, DB gateway_api_test.
#
# Uso:
#   docker compose up -d
#   mysql -h 127.0.0.1 -u root -prootsecret -e "CREATE DATABASE IF NOT EXISTS gateway_api_test;"
#   php artisan test
#
# CI (GitHub Actions) usa gateway/123456 via run-tests.yml — não altere o workflow.

APP_NAME=CoratriGatewayTest
APP_ENV=testing
APP_KEY=base64:iVoKOkyma32te1Ai0lq7UmR8RCCv3R9OsYAiAH8ZFMY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gateway_api_test
DB_USERNAME=root
DB_PASSWORD=rootsecret

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

JWT_SECRET=test_jwt_secret_key_for_automated_tests_only_do_not_use_in_production

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
