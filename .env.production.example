# ============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO - Gateway API
# ============================================================================
# 
# IMPORTANTE: Este arquivo serve como referência para configuração de produção.
# Copie as variáveis necessárias para seu .env de produção.
#
# CHECKLIST ANTES DE IR PARA PRODUÇÃO:
# [ ] Alterar APP_ENV para 'production'
# [ ] Desativar APP_DEBUG
# [ ] Configurar APP_URL com domínio real
# [ ] Configurar banco de dados de produção
# [ ] Configurar Redis de produção
# [ ] Configurar credenciais Adquirente PIX de produção
# [ ] Configurar FRONTEND_URL para CORS
# [ ] Gerar nova APP_KEY e JWT_SECRET
# [ ] Configurar certificado SSL
# [ ] Configurar backup de banco de dados
# [ ] Configurar monitoramento (Sentry, etc.)
#
# ============================================================================

# Configurações da Aplicação
APP_NAME="Gateway API"
APP_ENV=production
APP_KEY=base64:GERE_UMA_NOVA_CHAVE_AQUI
APP_DEBUG=false
APP_URL=https://api.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo

# Configurações de Log (produção: menos verbose)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Configurações do Banco de Dados (produção)
DB_CONNECTION=mysql
DB_HOST=seu-banco-producao.com
DB_PORT=3306
DB_DATABASE=gateway_api_prod
DB_USERNAME=gateway_prod
DB_PASSWORD=SENHA_FORTE_AQUI

# Configurações de Sessão
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Configurações de Cache (usar Redis em produção)
CACHE_STORE=redis

# Configurações do Redis
REDIS_CLIENT=phpredis
REDIS_HOST=seu-redis-producao.com
REDIS_PASSWORD=SENHA_REDIS_AQUI
REDIS_PORT=6379

# Configurações JWT
JWT_SECRET=GERE_UM_NOVO_SECRET_AQUI_64_CARACTERES
JWT_EXPIRATION_HOURS=24

# Configurações CORS (IMPORTANTE para segurança)
# Valores lidos via config/secure_cors.php — compatível com php artisan config:cache
FRONTEND_URL=https://app.seudominio.com.br
# Opcional: várias origens separadas por vírgula (ex. www + apex)
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com.br,https://www.seudominio.com.br

# ============================================================================
# Integração PIX genérica / custos
# ============================================================================
# Custo fixo por transação (R$) descontado do lucro líquido (app.custo_fixo_adquirente_pix)

# Webhook: configurar no painel do adquirente a URL do gateway

# ============================================================================
# OUTRAS CONFIGURAÇÕES DE PRODUÇÃO
# ============================================================================

# Segurança - IPs permitidos para saques (se aplicável)
ALLOWED_IPS=

# Queue (usar Redis ou database em produção)
QUEUE_CONNECTION=redis

# Mail (configurar para produção)
MAIL_MAILER=smtp
MAIL_HOST=smtp.seudominio.com.br
MAIL_PORT=587
MAIL_USERNAME=noreply@seudominio.com.br
MAIL_PASSWORD=SENHA_EMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@seudominio.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Segurança de autenticação
AUTH_MAX_ATTEMPTS_PER_IP=10
AUTH_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_DECAY_SECONDS=900
AUTH_LOCKOUT_MINUTES=30
AUTH_CAPTCHA_AFTER_FAILURES=3
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_TOTP_ISSUER="Coratri Finance"
AUTH_REQUIRE_2FA_FOR_ADMINS=true
JWT_BLACKLIST_ENABLED=true
AUTH_ALERT_WINDOW_MINUTES=5
AUTH_ALERT_FAILED_THRESHOLD=50
AUTH_ALERT_2FA_FAILED_THRESHOLD=30
AUTH_ALERT_IP_FAILED_THRESHOLD=10
AUTH_MAX_2FA_ATTEMPTS_PER_TEMP_TOKEN=5
AUTH_2FA_CAPTCHA_AFTER_FAILURES=3
# Fail-open se Cloudflare Turnstile estiver indisponível (use com cautela)
TURNSTILE_FAIL_OPEN=false
# Prazo ISO8601 após o qual PIN legado deixa de funcionar no verify-2fa
AUTH_TOTP_MIGRATION_DEADLINE=
AUTH_EVENTS_RETENTION_DAYS=90
# JWT blacklist exige cache compartilhado (Redis) em múltiplas instâncias
CACHE_STORE=redis
LOG_SLACK_WEBHOOK_URL=
AUTH_ALERT_SLACK_WEBHOOK=
AUTH_IP_REPUTATION_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_SCORE=75
