# Gerado/copiado por scripts/hardening-vps.sh
# TRUSTED_IPS é substituído na instalação.
#
# CRÍTICO: os ranges da Cloudflare estão em ignoreip. A origem fica 100% atrás da
# Cloudflare, então todo o tráfego chega por ~15 IPs CF. Sem isto, um IP da Cloudflare
# (partilhado por milhares de clientes) é banido e o site inteiro cai com erro 521.
# Mantido em sincronia com config/cloudflare.php e nginx-cloudflare-real-ip.conf.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 __TRUSTED_IPS__ 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
bantime  = 3600
findtime = 600
maxretry = 3
banaction = ufw
backend = auto

# SSH — brute force
[sshd]
enabled  = true
port     = ssh
maxretry = 3
bantime  = 86400
findtime = 600

# Path sensível — ban permanente (IPs em ignoreip do DEFAULT ficam isentos)
[nginx-sensitive]
enabled  = true
port     = http,https
filter   = nginx-sensitive
logpath  = /var/log/nginx/sensitive.log
maxretry = 1
bantime  = -1
findtime = 86400

# Abuso geral — 3 strikes em 10 min = 1h de ban
[nginx-4xx-abuse]
enabled  = true
port     = http,https
filter   = nginx-4xx-abuse
logpath  = /var/log/nginx/access.log
maxretry = 3
bantime  = 3600
findtime = 600

# Reincidentes — quem voltou a ser banido (IPs confiáveis isentos via ignoreip)
[recidive]
enabled  = true
filter   = recidive
logpath  = /var/log/fail2ban.log
action   = ufw
maxretry = 2
bantime  = 604800
findtime = 86400

# Brute force em login — 401/429 repetidos em /api/auth/*
[nginx-auth-bruteforce]
enabled  = true
port     = http,https
filter   = nginx-auth-bruteforce
logpath  = /var/log/nginx/access.log
maxretry = 10
bantime  = 3600
findtime = 300
